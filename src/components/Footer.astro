<script>
  // Schriftzug exakt auf die Breite des Footer-Inhalts bringen (bei Schriftladen und Größenänderung neu).
  const rahmen = document.querySelector<HTMLElement>('[data-wortmarke]');
  const text = rahmen?.querySelector<HTMLElement>('[data-wortmarke-text]');
  if (rahmen && text) {
    const einpassen = () => {
      text.style.fontSize = '100px';
      const breite100 = text.getBoundingClientRect().width;
      if (!breite100) return;
      text.style.fontSize = `${(rahmen.clientWidth / breite100) * 100}px`;
    };
    einpassen();
    document.fonts?.ready.then(einpassen);
    let wartet = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(wartet);
      wartet = window.setTimeout(einpassen, 120);
    });
  }
</script>
