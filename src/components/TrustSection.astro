<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const trustStats = document.querySelector<HTMLElement>('[data-trust-stats]');
  const trustYear = document.querySelector<HTMLElement>('[data-trust-year]');

  if (trustStats && trustYear) {
    // Zaehlt bis zum tatsaechlichen Gruendungsjahr hoch (siehe Kicker "seit 1952"
    // und Hero-Zeile "Garten- und Landschaftsbau seit 1952") — nicht darueber hinaus.
    const ZIEL_JAHR = 1952;
    const START_JAHR = ZIEL_JAHR - 4;
    const counter = { value: START_JAHR };
    ScrollTrigger.create({
      trigger: trustStats,
      start: 'top 85%',
      once: true,
      onEnter: () => {
        const baseSpacing = Number.parseFloat(getComputedStyle(trustYear).letterSpacing);
        gsap.to(counter, {
          value: ZIEL_JAHR,
          duration: 0.8,
          ease: 'power1.out',
          onUpdate: () => {
            trustYear.textContent = String(Math.round(counter.value));
            trustYear.style.letterSpacing = `${baseSpacing + ((counter.value - START_JAHR) / (ZIEL_JAHR - START_JAHR)) * 0.5}px`;
          },
        });
      },
    });
  }
</script>
